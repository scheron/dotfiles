# herdr-auto-title settings — symlinked to
#   ~/Library/Application Support/herdr-auto-title/config.env
# by setup-symlinks.sh. That path is fixed (os.UserConfigDir), and it is NOT
# the config dir `herdr plugin list` prints — the plugin does not read that one.
#
# Read once, when the herdr server starts the plugin. A change lands only after
#   herdr server stop     (then start herdr again)
#
# Every setting is listed, commented out, in the plugin's config.env.example.

# Titles read "<position> · <context> › <activity>". false drops the position,
# so a title starts with the work itself. The position is also the key that
# switches to that tab (prefix+1..9), and nothing else in the tab bar shows it.
HERDR_AUTO_TITLE_POSITION=false
